# Copy to .env. The Sanity CLI and Studio load it automatically (only SANITY_STUDIO_* reach the Studio).
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# The deployed web app, for the Presentation tool (defaults to http://localhost:3000)
SANITY_STUDIO_PREVIEW_URL=https://your-site.example.com

# Optional. Printed by the first `sanity deploy`; keeps later deploys on the same Studio
# SANITY_STUDIO_APP_ID=
