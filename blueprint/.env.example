# Copy to .env and fill in. Read by sanity.blueprint.ts and scripts/connect-rules.mjs, and
# forwarded to the Functions on deploy. Secrets (API keys, tokens) are NOT set here; add them with
# `pnpm dlx sanity@latest functions env add <function> <NAME> <value>`.

# Your Sanity project, dataset, and organization (Manage → Organization → Settings)
CONTEXT_PROJECT_ID=your-project-id
CONTEXT_DATASET=production
CONTEXT_ORGANIZATION_ID=your-organization-id

# Where the web app is deployed: Build Preview links point here
PREVIEW_BASE_URL=http://localhost:3000

# Optional. Context resource names; set once, before the first deploy
# KNOWLEDGE_BASE_NAME=page-rules
# KNOWLEDGE_BASE_TITLE=Page rules
# MCP_ENDPOINT=page-builder
# AUTHORING_ENDPOINT=authoring

# Optional. Claude model for Builds
# BUILD_MODEL=claude-opus-5-5
