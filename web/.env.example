# Copy to .env.local (and set the same variables in Vercel)
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
# Your deployed Studio, for click-to-edit overlays in Presentation
NEXT_PUBLIC_SANITY_STUDIO_URL=http://localhost:3333

# Server-only. Viewer token: draft mode, Preview links, the /brief status page
SANITY_API_READ_TOKEN=
# Server-only. Editor token: the /brief form creates Briefs
SANITY_API_WRITE_TOKEN=
